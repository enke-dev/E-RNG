{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "dialog:allow-ask",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-temp-read",
    "fs:allow-temp-write",
    "log:default",
    "opener:default",
    "os:default",
    "window-state:default"
  ]
}
