{
  "name": "e-rng",
  "version": "0.5.0",
  "private": true,
  "description": "Desktop app to create ZUGFeRD/Factur-X invoices and XRechnung XML",
  "homepage": "https://github.com/enke-dev/e-rng#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/enke-dev/e-rng.git"
  },
  "license": "UNLICENSED",
  "author": {
    "name": "David Enke",
    "email": "de@enke.dev"
  },
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "preinstall": "bunx only-allow bun",
    "prepare": "husky",
    "generate:sidecars": "bun run scripts/sidecars.ts",
    "generate:sidecars:stub": "bun run scripts/sidecars.ts --stub",
    "generate:icons": "bun run scripts/icons.ts",
    "generate": "bun run --parallel generate:icons generate:sidecars",
    "check": "tsc --noEmit",
    "lint": "bun run --parallel lint:rustfmt lint:clippy lint:eslint",
    "lint:rustfmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "lint:eslint": "eslint --config ./eslint.config.ts",
    "format": "bun run --parallel format:rustfmt format:eslint",
    "format:rustfmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:eslint": "eslint --config ./eslint.config.ts --fix",
    "test": "bun run --parallel test:vitest test:cargo",
    "test:vitest": "vitest run --config .configs/vite.config.ts --passWithNoTests",
    "test:cargo": "cargo test --manifest-path src-tauri/Cargo.toml",
    "dev": "tauri dev",
    "build": "tauri build"
  },
  "devDependencies": {
    "@awmottaz/prettier-plugin-void-html": "2.3.0",
    "@enke.dev/lint": "0.13.18",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@release-it/conventional-changelog": "12.0.2",
    "@tauri-apps/cli": "2.12.3",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "only-allow": "1.2.2",
    "prettier": "3.9.10",
    "release-it": "21.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-lit-css": "3.1.0",
    "vite-plugin-web-components-hmr": "0.1.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@awesome.me/webawesome": "3.14.0",
    "@lit-labs/router": "0.1.4",
    "@lit-labs/signals": "0.3.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-log": "2.10.1",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-os": "2.4.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.0",
    "element-internals-polyfill": "3.0.2",
    "lit": "3.3.3",
    "signal-polyfill": "0.2.2",
    "urlpattern-polyfill": "10.1.0"
  }
}
