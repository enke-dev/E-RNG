{
  "git": {
    "commitMessage": "chore: release ${version}",
    "tagName": "v${version}",
    "tagAnnotation": "E-Rng ${version}",
    "push": true,
    "pushArgs": ["--follow-tags"],
    "requireCleanWorkingDir": false,
    "requireUpstream": false
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": false,
    "skipChecks": true
  },
  "hooks": {
    "after:bump": [
      "perl -pi -e 's/^version = \"[^\"]*\"/version = \"${version}\"/ if $. <= 4' src-tauri/Cargo.toml",
      "perl -0pi -e 's/(name = \"e_rng\"\\nversion = )\"[^\"]*\"/$1\"${version}\"/' src-tauri/Cargo.lock",
      "jq --arg v \"${version}\" '.version = $v' src-tauri/tauri.conf.json > src-tauri/tauri.conf.json.tmp && mv src-tauri/tauri.conf.json.tmp src-tauri/tauri.conf.json",
      "git add src-tauri/Cargo.toml src-tauri/Cargo.lock src-tauri/tauri.conf.json"
    ]
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "angular",
      "infile": "CHANGELOG.md",
      "header": "# E-Rng"
    }
  }
}
